<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#0F1218</Color>
    <Color x:Key="SurfaceColor">#171B23</Color>
    <Color x:Key="SurfaceAltColor">#212733</Color>
    <Color x:Key="BorderColor">#2B3240</Color>
    <Color x:Key="TextColor">#E9ECF1</Color>
    <Color x:Key="MutedColor">#98A2B3</Color>
    <Color x:Key="AccentColor">#4C7CE8</Color>
    <Color x:Key="AccentHoverColor">#6190F0</Color>
    <Color x:Key="AccentSoftColor">#1D2B4D</Color>
    <Color x:Key="DangerColor">#EF6B6B</Color>
    <Color x:Key="DangerSoftColor">#3A2124</Color>
    <Color x:Key="SuccessColor">#4CC26B</Color>
    <Color x:Key="WarnColor">#E0A040</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000"/>
    <SolidColorBrush x:Key="ThumbBgBrush" Color="#212733"/>
</ResourceDictionary>
