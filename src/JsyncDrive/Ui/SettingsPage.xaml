<UserControl x:Class="JsyncDrive.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:JsyncDrive.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="{ui:T 'Settings'}" Style="{StaticResource H1}" Margin="0,0,0,22"/>

            <!-- account and connection -->
            <Border x:Name="AccountCard" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{ui:T 'Account and connection'}" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Ellipse x:Name="AccDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AccText" FontWeight="SemiBold" Margin="9,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{ui:T 'Hub address'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="HubBox" ui:Hint.Text="hub.example.com:7830" Margin="0,0,0,14"/>
                    <TextBlock Text="{ui:T 'Drive address'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ServerBox" ui:Hint.Text="https://api.example.com" Margin="0,0,0,14"/>
                    <TextBlock Text="{ui:T 'Name of this PC in your device list'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DeviceBox" Margin="0,0,0,14"/>
                    <CheckBox x:Name="ReadOnlySwitch" Style="{StaticResource Switch}" Content="{ui:T 'Read-only: never ask the server for write access'}" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveBtn" Style="{StaticResource PrimaryBtn}" Content="{ui:T 'Save'}" Click="OnSaveConnection" Margin="0,0,8,0"/>
                        <Button x:Name="SignInBtn" Content="{ui:T 'Sign in'}" Click="OnSignIn" Margin="0,0,8,0"/>
                        <Button x:Name="SignOutBtn" Style="{StaticResource DangerBtn}" Content="{ui:T 'Sign out'}" Click="OnSignOut"/>
                        <TextBlock x:Name="SaveNote" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <local:SignInPanel x:Name="SignIn" Visibility="Collapsed" Margin="0,18,0,0" xmlns:local="clr-namespace:JsyncDrive"/>
                </StackPanel>
            </Border>

            <!-- general -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{ui:T 'General'}" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{ui:T 'Language'}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LangBox" SelectionChanged="OnLang"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{ui:T 'Appearance'}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ThemeBox" SelectionChanged="OnTheme"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Start jsync Drive when I sign in to Windows'}" Checked="OnStartup" Unchecked="OnStartup"/>
                </StackPanel>
            </Border>

            <!-- role -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{ui:T 'How this PC is used'}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RoleText" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                    <CheckBox x:Name="AlsoClientSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Also use this PC as a client of its own hub'}" Checked="OnAlsoClient" Unchecked="OnAlsoClient" Margin="0,0,0,14"/>
                    <Button Content="{ui:T 'Change how this PC is used…'}" Click="OnChangeRole" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- about -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:T 'About'}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="EngineText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{ui:T 'Open data folder'}" Click="OnOpenData" Margin="0,0,8,0"/>
                        <Button Content="{ui:T 'Open logs'}" Click="OnOpenLogs"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
