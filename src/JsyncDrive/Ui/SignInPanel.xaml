<UserControl x:Class="JsyncDrive.SignInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:JsyncDrive.Ui">
    <StackPanel>
        <TextBlock x:Name="Intro" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="22,18">
            <StackPanel>
                <TextBlock Text="{ui:T 'Code'}" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CodeText" FontFamily="Cascadia Mono, Consolas" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="— — — —"/>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Click="OnCopy" ToolTip="{ui:T 'Copy'}">
                        <Path Data="{StaticResource IconCopy}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="OpenBtn" Style="{StaticResource PrimaryBtn}" Content="{ui:T 'Open the approval page'}" Click="OnOpen" Visibility="Collapsed"/>
                    <TextBlock x:Name="ManualText" Style="{StaticResource Muted}" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel x:Name="WaitRow" Orientation="Horizontal" Margin="0,16,0,0">
            <Ellipse x:Name="Pulse" Width="10" Height="10" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="WaitText" Margin="10,0,0,0" Style="{StaticResource Muted}"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        <Button x:Name="RetryBtn" Content="{ui:T 'Try again'}" Click="OnRetry" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
