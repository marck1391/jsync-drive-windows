<Window x:Class="JsyncDrive.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JsyncDrive.Ui"
        xmlns:local="clr-namespace:JsyncDrive"
        Style="{DynamicResource AppWindow}" Title="jsync Drive" Width="760" Height="700" MinHeight="620" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="48,40,48,16">
                <!-- 0: choose -->
                <StackPanel x:Name="StepChoose">
                    <Image Source="pack://application:,,,/Assets/app-256.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{ui:T 'Welcome to jsync Drive'}" Style="{StaticResource H1}" FontSize="30" Margin="0,18,0,6"/>
                    <TextBlock Text="{ui:T 'Your files and your devices, on your own network. How will this PC be used?'}" Style="{StaticResource Muted}" Margin="0,0,0,26" FontSize="15"/>

                    <RadioButton x:Name="ClientCard" GroupName="role" IsChecked="True" Cursor="Hand" Margin="0,0,0,14">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="16" Padding="22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <Path Data="{StaticResource IconCloud}" Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="18,0,12,0">
                                            <TextBlock Text="{ui:T 'As client'}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{ui:T 'Connect to a hub you already have. Your Drive shows up as a folder in Explorer, and you can browse it and send files to your other devices.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Path x:Name="tick" Grid.Column="2" Data="{StaticResource IconCheck}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="HubCard" GroupName="role" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="16" Padding="22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <Path Data="{StaticResource IconServer}" Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="18,0,12,0">
                                            <TextBlock Text="{ui:T 'As hub'}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{ui:T 'This PC becomes the server: it keeps the files of your Drive and connects all your devices. Other devices point at it.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Path x:Name="tick" Grid.Column="2" Data="{StaticResource IconCheck}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- 1: client details -->
                <StackPanel x:Name="StepClient" Visibility="Collapsed">
                    <TextBlock Text="{ui:T 'Connect to your hub'}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                    <TextBlock Text="{ui:T 'Ask whoever runs the hub for these two addresses.'}" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
                    <TextBlock Text="{ui:T 'Hub address'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="HubBox" ui:Hint.Text="hub.example.com:7830" Margin="0,0,0,16"/>
                    <TextBlock Text="{ui:T 'Drive address'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ServerBox" ui:Hint.Text="https://api.example.com" Margin="0,0,0,16"/>
                    <TextBlock Text="{ui:T 'Name of this PC in your device list'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DeviceBox" Margin="0,0,0,16"/>
                    <TextBlock Text="{ui:T 'Where should your Drive folder be?'}" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MountBox"/>
                        <Button Grid.Column="1" Content="{ui:T 'Choose…'}" Margin="8,0,0,0" Click="OnChooseMount"/>
                    </Grid>
                    <TextBlock Text="{ui:T 'Your files appear here as a normal folder. It can be empty or not exist yet.'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 2: hub details -->
                <StackPanel x:Name="StepHub" Visibility="Collapsed">
                    <TextBlock Text="{ui:T 'Set up this hub'}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                    <TextBlock Text="{ui:T 'Choose where the files of your Drive are kept.'}" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
                    <TextBlock Text="{ui:T 'Where the Drive files are kept'}" Style="{StaticResource Label}"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StorageBox"/>
                        <Button Grid.Column="1" Content="{ui:T 'Choose…'}" Margin="8,0,0,0" Click="OnChooseStorage"/>
                    </Grid>
                    <TextBlock Text="{ui:T 'Account service address (optional now)'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="AccountsBox" ui:Hint.Text="https://auth.example.com" Margin="0,0,0,14"/>
                    <TextBlock Text="{ui:T 'Account service secret (optional now)'}" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="SecretBox" Margin="0,0,0,14"/>
                    <TextBlock Text="{ui:T 'Your email, to administer the hub (optional now)'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="AdminBox" Margin="0,0,0,18"/>
                    <CheckBox x:Name="AlsoClientSwitch" Style="{StaticResource Switch}" IsChecked="True" Content="{ui:T 'Also use this PC as a client of this hub'}" Margin="0,0,0,12"/>
                    <Expander Header="{ui:T 'Ports'}" Foreground="{DynamicResource TextBrush}">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Hub port (devices connect here)'}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="LeafPortBox" Text="7830"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{ui:T 'Drive port'}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="DrivePortBox" Text="8780"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>

                <!-- 3: sign in -->
                <StackPanel x:Name="StepSignIn" Visibility="Collapsed">
                    <TextBlock Text="{ui:T 'Sign in'}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                    <TextBlock Text="{ui:T 'This links the PC to your account.'}" Style="{StaticResource Muted}" Margin="0,0,0,22"/>
                    <local:SignInPanel x:Name="SignIn"/>
                </StackPanel>

                <!-- 4: done -->
                <StackPanel x:Name="StepDone" Visibility="Collapsed">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <Path Data="{StaticResource IconCheck}" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{ui:T 'You are all set'}" Style="{StaticResource H1}" FontSize="30" Margin="0,18,0,8"/>
                    <TextBlock x:Name="DoneText" Style="{StaticResource Muted}" FontSize="15"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="48,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Note" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackBtn" Content="{ui:T 'Back'}" Click="OnBack" Margin="0,0,8,0" MinWidth="90"/>
                    <Button x:Name="NextBtn" Style="{StaticResource PrimaryBtn}" Content="{ui:T 'Continue'}" Click="OnNext" MinWidth="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
