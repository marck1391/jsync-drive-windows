<UserControl x:Class="JsyncDrive.FolderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:JsyncDrive.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="{ui:T 'Drive folder'}" Style="{StaticResource H1}"/>
            <TextBlock Text="{ui:T 'Your Drive as a normal folder in Explorer. Files are downloaded only when you open them, and changes go back to your Drive.'}" Style="{StaticResource Muted}" Margin="0,4,0,22"/>

            <!-- status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconFolder}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateTitle" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StateText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PathText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                        <Button x:Name="OpenBtn" Style="{StaticResource PrimaryBtn}" Content="{ui:T 'Open folder'}" Click="OnOpen" Margin="0,0,0,8"/>
                        <Button x:Name="ToggleBtn" Click="OnToggle"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- location -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{ui:T 'Folder on this PC'}" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DirBox" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="{ui:T 'Change…'}" Margin="8,0,0,0" Click="OnChangeDir"/>
                    </Grid>
                    <TextBlock Text="{ui:T 'Choose an empty folder, or one that does not exist yet.'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- options -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Keep the folder running in the background'}" Checked="OnEnabled" Unchecked="OnEnabled"/>
                    <TextBlock Text="{ui:T 'It starts when jsync Drive does and comes back by itself if it stops.'}" Style="{StaticResource Caption}" Margin="54,2,0,16"/>
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Start jsync Drive when I sign in to Windows'}" Checked="OnStartup" Unchecked="OnStartup"/>
                    <TextBlock Text="{ui:T 'Registered as a background task for your user; Windows restarts it if it crashes.'}" Style="{StaticResource Caption}" Margin="54,2,0,16"/>
                    <CheckBox x:Name="RwSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Let me change files here (read and write)'}" Checked="OnRw" Unchecked="OnRw"/>
                    <TextBlock Text="{ui:T 'Off: the folder is read-only. Deleted files go to the Drive trash.'}" Style="{StaticResource Caption}" Margin="54,2,0,16"/>
                    <TextBlock Text="{ui:T 'Free up disk space of files I have not opened for'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="FreeBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnFree"/>
                    <TextBlock Text="{ui:T 'The file stays in the folder and is downloaded again when you open it.'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- log -->
            <Expander Header="{ui:T 'Activity log'}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
                </Border>
            </Expander>

            <Button Content="{ui:T 'Remove the folder from Explorer…'}" Style="{StaticResource DangerBtn}" HorizontalAlignment="Left" Click="OnUnlink"/>
            <TextBlock Text="{ui:T 'A mounted folder stays registered with Windows until you remove it, like OneDrive. Do this before deleting it.'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
