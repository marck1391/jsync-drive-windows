<UserControl x:Class="JsyncDrive.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:JsyncDrive.Ui">
    <UserControl.Resources>
        <ui:BoolToVisibility x:Key="B2V"/>
        <ui:BoolToVisibility x:Key="NotB2V" Invert="True"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32" MaxWidth="980" HorizontalAlignment="Stretch">
            <TextBlock Text="{ui:T 'Devices'}" Style="{StaticResource H1}"/>
            <TextBlock Text="{ui:T 'Send files straight to your other devices, and choose who can send to this PC.'}" Style="{StaticResource Muted}" Margin="0,4,0,22"/>

            <!-- devices -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="{ui:T 'Your devices'}" Style="{StaticResource H2}"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource TextBtn}" Click="OnSendToAny" x:Name="SendAnyBtn" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="DevicesEmpty" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,8"/>
            <ItemsControl x:Name="DeviceList" Margin="0,0,0,26">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,14,14" Padding="18" AllowDrop="True" Drop="OnDeviceDrop" DragOver="OnDeviceDragOver" DragLeave="OnDeviceDragLeave">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                        <Path Data="{Binding Icon}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Click="OnToggleTrust" ToolTip="{Binding TrustTip}">
                                        <Path Data="{StaticResource IconStar}" Width="19" Height="19" Stretch="Uniform" Fill="{Binding StarBrush}"/>
                                    </Button>
                                </Grid>
                                <Button Style="{StaticResource PrimaryBtn}" Click="OnSendTo" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSend}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="{ui:T 'Send files…'}" Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{ui:T 'or drop files on this card'}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- in progress -->
            <StackPanel x:Name="LiveSection" Visibility="Collapsed" Margin="0,0,0,26">
                <TextBlock Text="{ui:T 'Right now'}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                <ItemsControl x:Name="LiveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}">
                                        <Path Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Fill="{Binding IconBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryBtn}" Content="{ui:T 'Accept'}" Click="OnLiveAccept" Visibility="{Binding Incoming, Converter={StaticResource B2V}}" Margin="0,0,8,0"/>
                                        <Button Content="{ui:T 'Always'}" Click="OnLiveAlways" Visibility="{Binding Incoming, Converter={StaticResource B2V}}" Margin="0,0,8,0" ToolTip="{ui:T 'Accept now, and from this device in the future'}"/>
                                        <Button Style="{StaticResource DangerBtn}" Content="{ui:T 'Decline'}" Click="OnLiveDecline" Visibility="{Binding Incoming, Converter={StaticResource B2V}}"/>
                                        <Button Content="{ui:T 'Cancel'}" Click="OnLiveCancel" Visibility="{Binding Cancellable, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- history -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="{ui:T 'Shared and received'}" Style="{StaticResource H2}"/>
                <Button x:Name="ClearBtn" HorizontalAlignment="Right" Style="{StaticResource TextBtn}" Content="{ui:T 'Clear history'}" Click="OnClearHistory"/>
            </Grid>
            <TextBlock x:Name="HistoryEmpty" Text="{ui:T 'Nothing yet. Files you send or receive will be listed here.'}" Style="{StaticResource Muted}" Margin="0,0,0,26"/>
            <Border x:Name="HistoryCard" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,26" Visibility="Collapsed">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2" MinHeight="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="19" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                                    <Path Data="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding BadgeFg}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,8,10,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource IconBtn}" Click="OnHistoryOpen" ToolTip="{ui:T 'Open'}" Visibility="{Binding CanOpen, Converter={StaticResource B2V}}">
                                        <Path Data="{StaticResource IconOpen}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Click="OnHistoryShow" ToolTip="{ui:T 'Show in folder'}" Visibility="{Binding CanOpen, Converter={StaticResource B2V}}">
                                        <Path Data="{StaticResource IconFolder}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Click="OnHistoryRemove" ToolTip="{ui:T 'Remove from the list'}">
                                        <Path Data="{StaticResource IconClose}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- receiving -->
            <TextBlock Text="{ui:T 'Receiving'}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:T 'Save received files in'}" Style="{StaticResource Label}"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReceiveDirBox" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="{ui:T 'Change…'}" Margin="8,0,0,0" Click="OnChangeReceiveDir"/>
                        <Button Grid.Column="2" Content="{ui:T 'Open'}" Margin="8,0,0,0" Click="OnOpenReceiveDir"/>
                    </Grid>
                    <CheckBox x:Name="PopupSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Show a window when someone sends me a file'}" Margin="0,0,0,12" Checked="OnPopupSwitch" Unchecked="OnPopupSwitch"/>
                    <CheckBox x:Name="AutoAllSwitch" Style="{StaticResource Switch}" Content="{ui:T 'Accept files from all my devices without asking'}" Margin="0,0,0,4" Checked="OnAutoAllSwitch" Unchecked="OnAutoAllSwitch"/>
                    <TextBlock Text="{ui:T 'Anyone signed in to your account can send to this PC, so this is only as safe as your devices are.'}" Style="{StaticResource Caption}" Margin="54,0,0,14" TextWrapping="Wrap"/>

                    <TextBlock Text="{ui:T 'Always accepted'}" Style="{StaticResource Label}" Margin="0,6,0,6"/>
                    <TextBlock x:Name="TrustedEmpty" Text="{ui:T 'No device yet. Press the star on a device, or choose “Always” when it asks.'}" Style="{StaticResource Muted}"/>
                    <ItemsControl x:Name="TrustedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconStar}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource WarnBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource TextBtn}" Content="{ui:T 'Remove'}" Click="OnUntrust"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
